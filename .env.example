# Copiez ce fichier en .env.local et remplissez-le (jamais commité).
# L'identité visuelle (nom, logo, couleurs…) se règle dans .env.

# URL publique du site (Open Graph, QR codes, liens des e-mails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Côté serveur uniquement, ne JAMAIS préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=""
