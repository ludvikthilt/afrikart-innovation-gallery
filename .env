# =============================================================================
#  IDENTITÉ DE LA GALERIE — tout ce qui est modifiable sans toucher au code
# =============================================================================
#  Ce fichier est COMMITÉ : n'y mettez JAMAIS de secret.
#  Les clés Supabase vont dans .env.local (non commité), voir .env.example.
#  Les variables NEXT_PUBLIC_* sont figées au moment du build :
#  après modification, relancez `npm run dev` / redéployez sur Vercel.
#  Une valeur vide = valeur par défaut définie dans src/config/brand.ts.
# =============================================================================

# --- Nom et signature --------------------------------------------------------
# Mot principal du logo texte (en-tête, pied de page, cartels imprimés)
NEXT_PUBLIC_BRAND_NAME="AFRIK'ART"
# Seconde ligne du logo texte
NEXT_PUBLIC_BRAND_SUBTITLE="Innovation Gallery"
# Nom complet (titres de page, Open Graph, e-mails, mentions légales)
NEXT_PUBLIC_BRAND_FULL_NAME="AFRIK'ART INNOVATION GALLERY"
# Accroche courte (FR / EN)
NEXT_PUBLIC_BRAND_TAGLINE_FR="La galerie phygitale des arts visuels africains"
NEXT_PUBLIC_BRAND_TAGLINE_EN="The phygital gallery of African visual arts"
# Description longue pour le SEO et le partage (FR / EN)
NEXT_PUBLIC_BRAND_DESCRIPTION_FR="Visitez des expositions d'art africain contemporain comme dans une vraie galerie, puis contactez directement les artistes."
NEXT_PUBLIC_BRAND_DESCRIPTION_EN="Walk through contemporary African art exhibitions as in a real gallery, then contact the artists directly."

# --- Logos et images ----------------------------------------------------------
# Chemins dans /public (ex. /brand/logo.svg) ou URL absolues.
# Logo vide = logo texte (NAME + SUBTITLE).
NEXT_PUBLIC_BRAND_LOGO_URL=""
# Symbole seul (masque), affiché à côté du nom en texte quand LOGO_URL est vide
NEXT_PUBLIC_BRAND_MARK_URL="/brand/mark.svg"
# Variante du logo pour fond clair (thème « musée blanc », cartels imprimés)
NEXT_PUBLIC_BRAND_LOGO_LIGHT_URL=""
# Icône d'onglet
NEXT_PUBLIC_BRAND_FAVICON_URL="/brand/mark.svg"
# Image de partage par défaut (1200×630) quand une page n'a pas d'œuvre
NEXT_PUBLIC_BRAND_OG_IMAGE_URL=""

# --- Couleurs (hex) -----------------------------------------------------------
# Couleurs du logo : bleu (accent principal), rose (accent secondaire), noir (texte)
NEXT_PUBLIC_BRAND_ACCENT="#1F56F5"
NEXT_PUBLIC_BRAND_ACCENT_HOVER="#1745C8"
NEXT_PUBLIC_BRAND_ACCENT_2="#FF3D8B"
NEXT_PUBLIC_BRAND_INK="#0B0C11"
# Fond du thème « nuit » et du thème « musée blanc » (thème par défaut)
NEXT_PUBLIC_BRAND_CANVAS_DARK="#0B0C11"
NEXT_PUBLIC_BRAND_CANVAS_LIGHT="#F6F6F4"

# --- Contact et réseaux ------------------------------------------------------
NEXT_PUBLIC_BRAND_CONTACT_EMAIL="contact@afrikart.gallery"
# Format international sans espaces, ex. +237600000000 (vide = masqué)
NEXT_PUBLIC_BRAND_WHATSAPP=""
NEXT_PUBLIC_BRAND_INSTAGRAM_URL=""
NEXT_PUBLIC_BRAND_FACEBOOK_URL=""
NEXT_PUBLIC_BRAND_TIKTOK_URL=""
NEXT_PUBLIC_BRAND_CITY="Dschang"
NEXT_PUBLIC_BRAND_COUNTRY="Cameroun"

# --- Événement mis en avant (bandeau / pied de page ; vide = masqué) ----------
NEXT_PUBLIC_EVENT_LABEL_FR="12e Festival Universitaire des Arts et de la Culture — UNIFAC, Université de Dschang, 23–27 novembre 2026"
NEXT_PUBLIC_EVENT_LABEL_EN="12th University Festival of Arts and Culture — UNIFAC, University of Dschang, 23–27 November 2026"

# --- Réglages ---------------------------------------------------------------
# Langue par défaut : fr | en
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
# Devise des prix saisis par les artistes
NEXT_PUBLIC_DEFAULT_CURRENCY="XAF"
# Mode borne : retour au hall après N minutes d'inactivité
NEXT_PUBLIC_KIOSK_IDLE_MINUTES="3"
